DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Alternative PostgreSQL variable names supplied by hosting integrations.
POSTGRES_URL=""
PRISMA_DATABASE_URL=""
SITE_ORIGIN="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
CRON_SECRET=""
# Stable dedicated HMAC key, at least 32 random characters. Never rotate casually.
SURVEY_EMAIL_SECRET=""
RESEND_API_KEY=""
# Sender on a domain verified in Resend, e.g. Sondages <sondages@example.org>
SURVEY_EMAIL_FROM=""
# Vercel Blob store must be PRIVATE. Never expose this token to the browser.
BLOB_READ_WRITE_TOKEN=""
# Create locally for the bootstrap command only. Do not add these to Vercel.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
