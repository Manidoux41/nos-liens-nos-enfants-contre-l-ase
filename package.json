{
  "name": "sondage-ase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:http": "node --experimental-strip-types --test tests/survey-http.mjs",
    "survey:prune": "node --env-file=.env --experimental-strip-types scripts/prune-survey.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:bootstrap": "node --env-file-if-exists=.env --experimental-strip-types scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "dotenv": "^17.2.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
