generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnHomeStatus {
  ALL
  SOME
  NONE
  NOT_APPLICABLE
  UNDISCLOSED
}

model SurveyResponse {
  id                   String           @id @default(uuid()) @db.Uuid
  deletionHash         String           @unique
  residence            String           @db.VarChar(16)
  ase                  String           @db.VarChar(16)
  placementYear        Int?
  returnHome           ReturnHomeStatus?
  judgeNames           String           @db.VarChar(600)
  socialWorkerNames    String           @db.VarChar(600)
  jurisdictionReported String           @db.VarChar(200)
  jurisdictionId       String?          @db.Uuid
  jurisdiction         Jurisdiction?    @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  consentVersion       String           @db.VarChar(40)
  privateConsent       Boolean          @default(false)
  status               ModerationStatus @default(PENDING)
  createdAt            DateTime         @default(now())
  expiresAt            DateTime
  moderatedAt          DateTime?
  moderatedById        String?
  moderatedBy          User?            @relation(fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([jurisdictionId, status])
}

model Jurisdiction {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique @db.VarChar(200)
  responses SurveyResponse[]
}

model SiteSettings {
  id             Int     @id @default(1)
  petitionUrl    String? @db.VarChar(1000)
  petitionTitle  String  @default("Préserver les liens, faire évoluer la protection de l’enfance") @db.VarChar(200)
  statsPublished Boolean @default(false)
}

model RequestBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?
  action    String   @db.VarChar(80)
  targetId  String?  @db.VarChar(80)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  role          String           @default("admin")
  active        Boolean          @default(true)
  sessions      Session[]
  accounts      Account[]
  moderated     SurveyResponse[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(100)
  slug     String    @unique @db.VarChar(120)
  articles Article[]
}

model Article {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(180)
  slug        String        @unique @db.VarChar(200)
  excerpt     String        @db.VarChar(500)
  content     String
  status      ArticleStatus @default(DRAFT)
  categoryId  String        @db.Uuid
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media       ArticleMedia[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  version     Int           @default(1)

  @@index([status, publishedAt])
  @@index([categoryId, status])
}

model Media {
  id         String         @id @default(uuid()) @db.Uuid
  title      String         @db.VarChar(180)
  alt        String         @db.VarChar(300)
  caption    String         @db.VarChar(500)
  pathname   String         @unique
  mimeType   String         @db.VarChar(50)
  size       Int
  deleting   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  articles   ArticleMedia[]
}

model ArticleMedia {
  articleId String  @db.Uuid
  mediaId   String  @db.Uuid
  position  Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([articleId, mediaId])
  @@index([mediaId])
}
